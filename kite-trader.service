[Unit]
Description=Kite Algo Trader Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/kite-algo-trader
EnvironmentFile=/home/ubuntu/kite-algo-trader/.env
ExecStart=/home/ubuntu/kite-algo-trader/venv/bin/python main.py
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
